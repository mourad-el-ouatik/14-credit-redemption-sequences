{
  "schema_version": 1,
  "description": "Witness scenarios for the credit-redemption audit. Expected values come from inputs/credit-policy.md (CR1-CR6), not from the model's behaviour.",
  "reset": "Every scenario starts from a fresh deep copy of inputs/state.json with the scenario's offer_caps applied. Nothing is shared between scenarios; order of actions inside a scenario matters.",
  "state_field": "'unchanged' = the complete state equals the state before the action; otherwise an object giving the complete expected accounts, claims and requests after the action. Offers must stay equal to the start state in every case.",
  "invariants": "CR6 must hold after every action (conservation, non-negative balances, claim/request bijection, offers unmutated).",
  "scenarios": [
    {
      "id": "W01",
      "title": "exact cap is accepted",
      "rules": [
        "CR2",
        "CR3"
      ],
      "category": "legitimate",
      "related": [],
      "purpose": "Amount equal to the cap (30 with cap 30) is valid: cap is inclusive.",
      "offer_caps": {
        "spring": 30
      },
      "actions": [
        {
          "id": "W01.1",
          "request_id": "W01-R1",
          "account": "A",
          "offer": "spring",
          "amount": 30
        }
      ],
      "expected": [
        {
          "action": "W01.1",
          "response": {
            "code": "ok",
            "amount": 30
          },
          "state": {
            "accounts": {
              "A": 70,
              "B": 20
            },
            "claims": {
              "A/spring": 30
            },
            "requests": {
              "W01-R1": {
                "payload": [
                  "A",
                  "spring",
                  30
                ],
                "response": {
                  "code": "ok",
                  "amount": 30
                }
              }
            }
          }
        }
      ]
    },
